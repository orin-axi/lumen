{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumen.techworx.dev/schemas/read-contracts/v1.schema.json",
  "title": "Lumen Read Contract v1",
  "description": "Source of truth for every ReadContractEnvelope<T> Lumen serializes at the CLI/API boundary (SPEC-LUMEN-003-STORE, CRIT-LUMEN-038). Any external consumer -- including a future Mac app -- validates against this file, not the reverse. Covers type, required fields, and additionalProperties:false; JSON Schema has no key-ordering construct, so exact key order is verified separately by a golden-file byte-for-byte comparison test.",
  "$defs": {
    "ModelTokenSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cache_creation_tokens", "cache_read_tokens", "reasoning_tokens", "cost_usd", "turns", "is_fully_priced"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number" },
        "turns": { "type": "integer", "minimum": 0 },
        "is_fully_priced": { "type": "boolean" }
      }
    },
    "TokenEconomics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens", "output_tokens", "cache_creation_tokens", "cache_read_tokens",
        "ephemeral_5m_tokens", "ephemeral_1h_tokens", "cache_hit_ratio", "total_cost_usd",
        "provided_cost_usd", "baseline_cost_no_cache_usd", "net_savings_usd",
        "efficiency_multiplier", "per_model", "reasoning_output_tokens", "is_fully_priced"
      ],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_tokens": { "type": "integer", "minimum": 0 },
        "ephemeral_5m_tokens": { "type": "integer", "minimum": 0 },
        "ephemeral_1h_tokens": { "type": "integer", "minimum": 0 },
        "cache_hit_ratio": { "type": "number" },
        "total_cost_usd": { "type": "number" },
        "provided_cost_usd": { "type": ["number", "null"] },
        "baseline_cost_no_cache_usd": { "type": "number" },
        "net_savings_usd": { "type": "number" },
        "efficiency_multiplier": { "type": "number" },
        "per_model": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/ModelTokenSummary" }
        },
        "reasoning_output_tokens": { "type": "integer", "minimum": 0 },
        "is_fully_priced": { "type": "boolean" }
      }
    },
    "SessionSummaryReadModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "session_id", "model_family", "turn_count", "wall_duration_ms", "cache_hit_ratio", "total_cost_usd", "net_savings_usd", "created_at"],
      "properties": {
        "id": { "type": "integer" },
        "provider": { "type": "string" },
        "session_id": { "type": "string" },
        "model_family": { "type": "string" },
        "turn_count": { "type": "integer", "minimum": 0 },
        "wall_duration_ms": { "type": "integer", "minimum": 0 },
        "cache_hit_ratio": { "type": "number" },
        "total_cost_usd": { "type": "number" },
        "net_savings_usd": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "SessionDetailReadModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "economics", "tool_counts", "error_counts"],
      "properties": {
        "summary": { "$ref": "#/$defs/SessionSummaryReadModel" },
        "economics": { "$ref": "#/$defs/TokenEconomics" },
        "tool_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "error_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "FindingReadModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "session_id", "rule_id", "severity", "confidence", "title", "message"],
      "properties": {
        "id": { "type": "integer" },
        "session_id": { "type": "string" },
        "rule_id": { "type": "string" },
        "severity": { "type": "string" },
        "confidence": { "type": "number" },
        "title": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "ToolCallReadModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "session_id", "turn_index", "tool_name", "call_id", "intent_kind", "is_error", "latency_ms"],
      "properties": {
        "id": { "type": "integer" },
        "session_id": { "type": "integer" },
        "turn_index": { "type": "integer", "minimum": 0 },
        "tool_name": { "type": "string" },
        "call_id": { "type": "string" },
        "intent_kind": { "type": "string" },
        "is_error": { "type": "boolean" },
        "latency_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "RollupReadModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "period_start", "period_type", "session_count", "total_cost_usd", "total_savings_usd", "total_duration_ms"],
      "properties": {
        "id": { "type": "integer" },
        "period_start": { "type": "string", "format": "date-time" },
        "period_type": { "type": "string" },
        "session_count": { "type": "integer", "minimum": 0 },
        "total_cost_usd": { "type": "number" },
        "total_savings_usd": { "type": "number" },
        "total_duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "SessionSummaryEnvelope": {
      "description": "Wraps `lumen sessions`' list output -- data is an array (list_recent returns Vec<SessionSummaryReadModel>), not a single object.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "data"],
      "properties": {
        "contract_version": { "type": "string" },
        "data": { "type": "array", "items": { "$ref": "#/$defs/SessionSummaryReadModel" } }
      }
    },
    "SessionDetailEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "data"],
      "properties": { "contract_version": { "type": "string" }, "data": { "$ref": "#/$defs/SessionDetailReadModel" } }
    },
    "FindingEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "data"],
      "properties": { "contract_version": { "type": "string" }, "data": { "$ref": "#/$defs/FindingReadModel" } }
    },
    "ToolCallEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "data"],
      "properties": { "contract_version": { "type": "string" }, "data": { "$ref": "#/$defs/ToolCallReadModel" } }
    },
    "RollupEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "data"],
      "properties": { "contract_version": { "type": "string" }, "data": { "$ref": "#/$defs/RollupReadModel" } }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/SessionSummaryEnvelope" },
    { "$ref": "#/$defs/SessionDetailEnvelope" },
    { "$ref": "#/$defs/FindingEnvelope" },
    { "$ref": "#/$defs/ToolCallEnvelope" },
    { "$ref": "#/$defs/RollupEnvelope" }
  ]
}
